# Google OAuth (used for sign-in)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5173/login/google/callback

# Set to "production" when deploying; leave unset for local development
ENVIRONMENT=development

# Only required for production database migrations (Cloudflare D1 over HTTP)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_DATABASE_ID=your_cloudflare_d1_database_id
CLOUDFLARE_D1_TOKEN=your_cloudflare_d1_api_token
